root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# PowerShell 5.1 reads BOM-less files as ANSI and breaks Polish characters.
[*.{ps1,psm1}]
charset = utf-8-bom
end_of_line = crlf

[*.{cmd,bat}]
end_of_line = crlf

[*.{cs,xaml,csproj,sln}]
end_of_line = crlf

[*.{yml,yaml,json,html,css,js}]
indent_size = 2
