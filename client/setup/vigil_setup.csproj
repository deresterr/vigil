<Project Sdk="Microsoft.NET.Sdk">

  <!-- vigil_setup.exe: installer (wizard, menu, parameter mode), verify and the guardian task, D22.
       Console, run elevated (app.manifest). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vigil.Setup</RootNamespace>
    <AssemblyName>vigil_setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Nothing extracted at run time (D24); build-package.ps1 fails if a native library would be left over. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <StartupHookSupport>false</StartupHookSupport>
    <!-- A console tool, unlike the WPF/WinForms exes: trimmed and compressed it stays small. Partial: only
         assemblies marked trimmable (the framework) are trimmed, our code and packages are kept whole. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
    <!-- The wizard and the menu (D22). MIT. -->
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\VigilLayout.cs" Link="Shared\VigilLayout.cs" />
    <Compile Include="..\shared\FileAcls.cs" Link="Shared\FileAcls.cs" />
  </ItemGroup>

</Project>
