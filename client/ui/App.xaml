<Application x:Class="Vigil.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- ShutdownMode=OnExplicitShutdown: the app ends only on Shutdown(), not with its first window; the lock
         windows (one per monitor) are recreated on DisplaySettingsChanged. -->
    <Application.Resources>
        <!-- Night palette: black background, muted text. A locked screen at night must not light up the
             room; the text stays readable without emitting much light. -->
        <SolidColorBrush x:Key="BackgroundDarkBrush" Color="#000000"/>
        <SolidColorBrush x:Key="ForegroundLightBrush" Color="#9a9a9a"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#707070"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4a6888"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#8a4040"/>

        <!-- Style globalne -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#9a9a9a"/>
            <Setter Property="BorderBrush" Value="#3a3a3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0f0f0f"/>
            <Setter Property="Foreground" Value="#b8b8b8"/>
            <Setter Property="BorderBrush" Value="#3a3a3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="CaretBrush" Value="#b8b8b8"/>
        </Style>
    </Application.Resources>
</Application>
