<Window x:Class="Vigil.Ui.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vigil.Ui.ViewModels"
        xmlns:ui="clr-namespace:Vigil.Ui"
        WindowStyle="None"
        WindowState="Normal"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource BackgroundDarkBrush}"
        Foreground="{StaticResource ForegroundLightBrush}"
        FontFamily="Segoe UI"
        Cursor="Arrow">

    <Window.Resources>
        <!-- BooleanToVisibilityConverter is not in the app resources: declared here -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Phase visibility (DataTrigger) -->
        <Style x:Key="PhasePanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Clock, top right, 72 pt: readable across the room -->
        <TextBlock Text="{Binding CurrentTime}"
                   FontSize="72"
                   FontWeight="Light"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,40,60,0"
                   Foreground="{StaticResource MutedBrush}"/>

        <!-- Centre panel: content by Phase -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">

            <!-- === PHASE: Locked === -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phase}" Value="{x:Static vm:LockUiPhase.Locked}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Main message (48 pt): a little brighter than the default foreground for contrast, still
                     muted so it does not glow at night -->
                <TextBlock Text="{Binding MainMessage}"
                           FontSize="48"
                           FontWeight="Light"
                           Foreground="#a8a8a8"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="40,20,40,40"/>

                <!-- TOTP field (warunkowo) -->
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            Visibility="{Binding ShowTotpField, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{x:Static ui:Strings.EnterCode}"
                               FontSize="22"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBox x:Name="TotpInput"
                                 Text="{Binding TotpCode, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220"
                                 FontSize="36"
                                 TextAlignment="Center"
                                 MaxLength="6"
                                 InputScope="Number"
                                 KeyDown="TotpInput_KeyDown"
                                 PreviewKeyDown="TotpInput_PreviewKeyDown"
                                 PreviewTextInput="TotpInput_PreviewTextInput"
                                 IsVisibleChanged="TotpInput_IsVisibleChanged"/>
                        <Button Content="{x:Static ui:Strings.Check}"
                                Margin="16,0,0,0"
                                Padding="30,10"
                                Click="CheckTotp_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Retry button (warunkowo) -->
                <Button Content="{x:Static ui:Strings.RetryConnection}"
                        Margin="0,30,0,0"
                        Padding="40,16"
                        FontSize="22"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ShowRetryButton, Converter={StaticResource BoolToVis}}"
                        Click="Retry_Click"/>

                <!-- Time left: during a pause only, when > 0 -->
                <TextBlock Text="{Binding MinutesRemainingText}"
                           FontSize="32"
                           FontWeight="Light"
                           Foreground="#22c55e"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowResumeButton}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Odblokuj (pauza) -->
                <Button Content="{x:Static ui:Strings.Resume}"
                        Margin="0,20,0,0"
                        Padding="50,18"
                        FontSize="26"
                        FontWeight="Medium"
                        HorizontalAlignment="Center"
                        Background="#16a34a"
                        Foreground="White"
                        BorderThickness="0"
                        Visibility="{Binding ShowResumeButton, Converter={StaticResource BoolToVis}}"
                        Click="ResumeFromPause_Click"/>

                <!-- Status (wrong code, lockout): a muted red that marks the error without glowing at night -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#a05858"
                           FontSize="20"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="600"/>
            </StackPanel>

            <!-- === PHASE: GrantPending === -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phase}" Value="{x:Static vm:LockUiPhase.GrantPending}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{x:Static ui:Strings.Sending}"
                           FontSize="36"
                           FontWeight="Light"
                           Foreground="#a8a8a8"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- === PHASE: GrantApplied === -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phase}" Value="{x:Static vm:LockUiPhase.GrantApplied}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="36"
                           FontWeight="Light"
                           Foreground="#a8a8a8"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="40"/>
                <TextBlock Text="{x:Static ui:Strings.UnlockingSoon}"
                           FontSize="22"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>

        </Grid>

        <!-- Shut down: bottom right, unobtrusive -->
        <Button Content="{x:Static ui:Strings.ShutDown}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,40,40"
                Padding="20,10"
                FontSize="16"
                Background="Transparent"
                BorderThickness="1"
                Foreground="{StaticResource MutedBrush}"
                Click="Shutdown_Click"/>
    </Grid>
</Window>
