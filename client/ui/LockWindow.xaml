<Window x:Class="Vigil.Ui.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vigil.Ui.ViewModels"
        xmlns:ui="clr-namespace:Vigil.Ui"
        WindowStyle="None"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{x:Static ui:Palette.Background}"
        Foreground="{x:Static ui:Palette.Detail}"
        FontFamily="Segoe UI"
        Cursor="Arrow">

    <!-- Black for the night, the state's color (the parent panel's) only on the badge, the
         controls outlined in the panel's accent. Placement and the system menu: LockWindow.xaml.cs. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="{x:Static ui:Palette.Title}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNight}" Value="True">
                    <Setter Property="Foreground" Value="{x:Static ui:Palette.TitleNight}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{x:Static ui:Palette.Detail}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNight}" Value="True">
                    <Setter Property="Foreground" Value="{x:Static ui:Palette.DetailNight}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The round badge with the state's icon -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="CornerRadius" Value="44"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNight}" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeIcon" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Clock, top right: the server's time -->
        <TextBlock Text="{Binding CurrentTime}"
                   FontSize="64"
                   FontWeight="Light"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,36,56,0"
                   Foreground="{x:Static ui:Palette.Muted}"/>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1000">

            <!-- === PHASE: Locked === -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phase}" Value="{x:Static vm:LockUiPhase.Locked}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Style="{StaticResource Badge}" BorderBrush="{Binding StateBrush}">
                    <Viewbox Width="44" Height="44">
                        <Path Style="{StaticResource BadgeIcon}" Data="{Binding StateIcon}" Stroke="{Binding StateBrush}"/>
                    </Viewbox>
                </Border>
                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" Margin="40,0"/>
                <TextBlock Style="{StaticResource DetailText}" Text="{Binding Detail}" Margin="40,10,40,0"/>

                <!-- Code from the parent -->
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            Margin="0,40,0,0"
                            Visibility="{Binding ShowTotpField, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{x:Static ui:Strings.EnterCode}"
                               FontSize="20"
                               Foreground="{x:Static ui:Palette.Muted}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBox x:Name="TotpInput"
                                 Text="{Binding TotpCode, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220"
                                 FontSize="36"
                                 TextAlignment="Center"
                                 MaxLength="7"
                                 InputScope="Number"
                                 KeyDown="TotpInput_KeyDown"
                                 PreviewKeyDown="TotpInput_PreviewKeyDown"
                                 PreviewTextInput="TotpInput_PreviewTextInput"
                                 TextChanged="TotpInput_TextChanged"
                                 IsVisibleChanged="TotpInput_IsVisibleChanged"/>
                        <Button Content="{x:Static ui:Strings.Check}"
                                Style="{StaticResource AccentButton}"
                                Margin="16,0,0,0"
                                Padding="30,10"
                                Click="CheckTotp_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Retry: the watchdog's own offline lock -->
                <Button Content="{x:Static ui:Strings.RetryConnection}"
                        Margin="0,24,0,0"
                        Padding="32,12"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ShowRetryButton, Converter={StaticResource BoolToVis}}"
                        Click="Retry_Click"/>

                <!-- Back to the computer: pause only -->
                <Button Content="{x:Static ui:Strings.Resume}"
                        Style="{StaticResource AccentButton}"
                        Margin="0,40,0,0"
                        Padding="44,16"
                        FontSize="24"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ShowResumeButton, Converter={StaticResource BoolToVis}}"
                        Click="ResumeFromPause_Click"/>

                <!-- Status (wrong code, lockout) -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{x:Static ui:Palette.Problem}"
                           FontSize="20"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="640"/>
            </StackPanel>

            <!-- === PHASE: GrantPending === -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phase}" Value="{x:Static vm:LockUiPhase.GrantPending}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource TitleText}" Text="{x:Static ui:Strings.Sending}" FontSize="36"/>
            </StackPanel>

            <!-- === PHASE: GrantApplied === -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phase}" Value="{x:Static vm:LockUiPhase.GrantApplied}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource TitleText}" Text="{Binding StatusMessage}" FontSize="36" Margin="40,0"/>
                <TextBlock Style="{StaticResource DetailText}" Text="{x:Static ui:Strings.UnlockingSoon}" FontSize="22"
                           Margin="0,16,0,0"/>
            </StackPanel>

            <!-- === PHASE: ConfirmShutdown === -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Phase}" Value="{x:Static vm:LockUiPhase.ConfirmShutdown}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource Badge}" BorderBrush="{x:Static ui:Palette.Lock}">
                    <Viewbox Width="44" Height="44">
                        <Path Style="{StaticResource BadgeIcon}" Data="{x:Static ui:Icons.Power}" Stroke="{x:Static ui:Palette.Lock}"/>
                    </Viewbox>
                </Border>
                <TextBlock Style="{StaticResource TitleText}" Text="{x:Static ui:Strings.ShutDownConfirm}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                    <Button x:Name="ConfirmShutdownButton"
                            Content="{x:Static ui:Strings.ShutDownYes}"
                            Style="{StaticResource PowerButton}"
                            Padding="36,12"
                            Click="ConfirmShutdown_Click"/>
                    <Button Content="{x:Static ui:Strings.Cancel}"
                            Margin="16,0,0,0"
                            Padding="36,12"
                            Click="CancelShutdown_Click"/>
                </StackPanel>
            </StackPanel>

        </Grid>

        <!-- Shut down: bottom right, unobtrusive -->
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,40,40"
                Padding="16,8"
                FontSize="16"
                Foreground="{x:Static ui:Palette.Muted}"
                Click="Shutdown_Click">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource BadgeIcon}" Data="{x:Static ui:Icons.Power}" Stroke="{x:Static ui:Palette.Muted}"
                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static ui:Strings.ShutDown}" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
