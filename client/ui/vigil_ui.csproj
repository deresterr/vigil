<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WPF + WinForms for Screen.AllScreens (one lock window per monitor) and NotifyIcon (tray). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vigil.Ui</RootNamespace>
    <AssemblyName>vigil_ui</AssemblyName>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms=true dodaje "using System.Windows.Forms" jako implicit global,
         co konfliktuje z WPF (Application, KeyEventArgs istnieją w obu). Używamy aliasu
         WinFormsScreen w plikach które potrzebują Screen.AllScreens — implicit nie potrzebny. -->
    <Using Remove="System.Windows.Forms" />
    <Compile Include="..\shared\IpcMessages.cs" Link="IpcMessages.cs" />
  </ItemGroup>

</Project>
