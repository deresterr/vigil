<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WPF + WinForms for Screen.AllScreens (one lock window per monitor) and NotifyIcon (tray). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vigil.Ui</RootNamespace>
    <AssemblyName>vigil_ui</AssemblyName>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- D24: WPF's native DLLs are published next to vigil_ui.exe and installed in ProgramData (admin-only
         write), never extracted to the child's %TEMP%, where a planted DLL would load into the lock screen. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <StartupHookSupport>false</StartupHookSupport>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds an implicit global "using System.Windows.Forms", which clashes with WPF
         (Application, KeyEventArgs exist in both). Files that need WinForms types alias them. -->
    <Using Remove="System.Windows.Forms" />
    <Compile Include="..\shared\IpcMessages.cs" Link="IpcMessages.cs" />
  </ItemGroup>

</Project>
