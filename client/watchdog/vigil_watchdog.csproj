<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vigil.Watchdog</RootNamespace>
    <AssemblyName>vigil_watchdog</AssemblyName>
    <UserSecretsId>vigil-watchdog</UserSecretsId>

    <!-- One self-contained exe, no .NET runtime needed on the PC. Nothing extracted at run time (D24):
         build-package.ps1 fails if a native library would have to sit next to it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <StartupHookSupport>false</StartupHookSupport>
    <!-- Not trimmed: the hosting/DI and Win32 interop give trimming warnings that are not worth chasing. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Latest analyzers, warnings not errors (a new SDK must not break the build). -->
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- LibraryImport generates unsafe code (pointer marshalling); without it SYSLIB1062 + CS0227. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!-- vigil.toml -->
    <PackageReference Include="Tomlyn" Version="0.17.0" />
    <!-- DPAPI (signing.dat, totp.dat) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- EventLogReader: the guardian's findings (Guardian/GuardianReporter.cs) -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\IpcMessages.cs" Link="Ui\IpcMessages.cs" />
    <!-- Installation layout shared with vigil_setup (D22): paths, entropy, service, policies, ACLs -->
    <Compile Include="..\shared\VigilLayout.cs" Link="Shared\VigilLayout.cs" />
    <Compile Include="..\shared\FileAcls.cs" Link="Shared\FileAcls.cs" />
  </ItemGroup>

</Project>
