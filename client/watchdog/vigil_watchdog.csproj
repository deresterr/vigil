<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vigil.Watchdog</RootNamespace>
    <AssemblyName>vigil_watchdog</AssemblyName>
    <UserSecretsId>vigil-watchdog</UserSecretsId>

    <!-- Single-file self-contained publish (cel: jeden exe, brak zależności od .NET runtime na PC) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Trimming wyłączone: P/Invoke + reflection na Win32 API + System.Security.Cryptography
         łatwo daje fałszywe trimming warnings. Single-file 80MB to akceptowalna cena. -->

    <!-- Najwyższy poziom warningów ale bez warning-as-error (aby kod był odporny na świeże analyzery) -->
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- LibraryImport source generator generuje kod z `unsafe` blokami (do marshalingu pointerów).
         Bez tego flagi: error SYSLIB1062 + CS0227. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <!-- Tomlyn jest stabilny i mały. Alternatywa: ręczny mini-parser, ale konfig może urosnąć. -->
    <PackageReference Include="Tomlyn" Version="0.17.0" />
    <!-- DPAPI wrapper. W .NET Framework był built-in, w .NET 8+ jest osobny package. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- NamedPipeServerStreamAcl + PipeSecurity (DACL na pipe). W .NET 8 osobny package. -->
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\IpcMessages.cs" Link="Ui\IpcMessages.cs" />
  </ItemGroup>

</Project>
