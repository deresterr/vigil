# Copy to .env. Only infrastructure lives here: passwords, TOTP, limits and the time zone of the schedule
# are set in the /setup wizard and the panel.

# Host port (also used inside the container).
VIGIL_PORT=8088

# Optional: run a release image instead of building locally, e.g. ghcr.io/deresterr/vigil-server:0.9.1
# (then: docker compose pull && docker compose up -d). Empty = build from this directory.
VIGIL_IMAGE=

# Optional: time zone of the server's log timestamps (e.g. Europe/Warsaw). Default UTC.
TZ=

# Optional: 1 = log without colors (ANSI codes), e.g. when the log goes to a file. Empty = colored.
NO_COLOR=

# Optional, only behind a reverse proxy (e.g. one adding TLS): the address the proxy connects to Vigil from, or a
# comma-separated list / network (e.g. 172.18.0.5 or 172.18.0.0/16). Vigil then takes the client's address and
# https from the proxy's X-Forwarded-For / X-Forwarded-Proto: login limits stay per device and the panel's cookie
# becomes Secure. Never "*": anyone could send a made-up X-Forwarded-For and get round the login limit.
# Empty = the headers are ignored.
FORWARDED_ALLOW_IPS=
