# Copy to .env. Only infrastructure lives here — passwords, TOTP and limits are set in the /setup wizard.

# Instance name: container name + data subdirectory (./data/<VIGIL_CHILD>/). Lowercase, no spaces.
# One instance serves all children; keep the old value when upgrading from a per-PC setup.
VIGIL_CHILD=vigil

# Host port (also used inside the container).
VIGIL_PORT=8088

# Optional: run a release image instead of building locally, e.g. ghcr.io/deresterr/vigil-server:0.7.0
# (then: docker compose pull && docker compose up -d). Empty = build from this directory.
VIGIL_IMAGE=
