# Copy to .env. Only infrastructure lives here: passwords, TOTP, limits and the time zone of the schedule
# are set in the /setup wizard and the panel.

# Host port (also used inside the container).
VIGIL_PORT=8088

# Optional: run a release image instead of building locally, e.g. ghcr.io/deresterr/vigil-server:0.8.0
# (then: docker compose pull && docker compose up -d). Empty = build from this directory.
VIGIL_IMAGE=

# Optional: time zone of the server's log timestamps (e.g. Europe/Warsaw). Default UTC.
TZ=
