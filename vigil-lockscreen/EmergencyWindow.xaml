<Window x:Class="Vigil.Lockscreen.EmergencyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Normal"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Width="500" Height="320"
        Background="#000000"
        FontFamily="Segoe UI">

    <Border BorderBrush="#3a3a3a" BorderThickness="2" Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Awaryjne odblokowanie"
                       FontSize="22"
                       FontWeight="Light"
                       Foreground="#a8a8a8"
                       Margin="0,0,0,12"/>

            <TextBlock Grid.Row="1"
                       Text="Wpisz hasło awaryjne ustawione podczas instalacji. Po poprawnym haśle blokada zostanie zdjęta na 24h."
                       FontSize="14"
                       Foreground="#707070"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <PasswordBox Grid.Row="2"
                         x:Name="PasswordInput"
                         FontSize="22"
                         Padding="12"
                         Background="#0f0f0f"
                         Foreground="#b8b8b8"
                         BorderBrush="#3a3a3a"
                         BorderThickness="1"
                         CaretBrush="#b8b8b8"
                         Margin="0,0,0,16"
                         KeyDown="PasswordInput_KeyDown"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText"
                           Text=""
                           Foreground="#a05858"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <Button Content="Anuluj"
                        Width="100" Height="40"
                        Background="#1a1a1a" Foreground="#909090"
                        BorderBrush="#2a2a2a" BorderThickness="1"
                        FontSize="16"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Odblokuj"
                        Width="120" Height="40"
                        Background="#222222" Foreground="#a8a8a8"
                        BorderBrush="#3a3a3a" BorderThickness="1"
                        FontSize="16"
                        Click="Unlock_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
